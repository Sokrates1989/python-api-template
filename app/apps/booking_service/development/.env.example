# Copy to .env, keep it ignored, and replace every placeholder with a unique
# URL-safe local-only value of at least 24 characters.
BOOKING_LOCAL_DB_PASSWORD=replace-with-local-only-database-password
BOOKING_LOCAL_ADMIN_API_KEY=replace-with-local-only-admin-key
BOOKING_LOCAL_RESTORE_API_KEY=replace-with-local-only-restore-key
BOOKING_LOCAL_DELETE_API_KEY=replace-with-local-only-delete-key

# The Keycloak reconciler owns this ignored credential file. Forward slashes
# keep the bind-mount value portable through Docker Desktop on Windows.
BOOKING_LOCAL_BACKEND_SECRET_PATH=D:/Development/Code/keycloak/data/local-realms/booking-service-example/backend-client-secret

# Public loopback ports. Change only when another local service owns a port.
BOOKING_LOCAL_API_PORT=8084
BOOKING_LOCAL_POSTGRES_PORT=5544
BOOKING_LOCAL_REDIS_PORT=6384
