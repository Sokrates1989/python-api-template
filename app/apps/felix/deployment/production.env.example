# Felix production runtime contract (non-secret example values only).
# Docker Swarm owns the files below and mounts them under /run/secrets.
# Deployment identity may differ from these examples when all documented
# relationships remain coherent and every public URL/identifier is safe.
APP_ENVIRONMENT=production
BACKEND_APP_ID=felix
APP_PROFILE=felix

DB_TYPE=postgresql
DB_MODE=external
DB_HOST=postgres
DB_PORT=5432
DB_NAME=felix
DB_USER=felix
DB_PASSWORD_FILE=/run/secrets/felix_db_password

# One or more comma-separated, exact public HTTPS browser origins.
CORS_ORIGINS=https://app.example.com

AUTH_PROVIDER=keycloak
KEYCLOAK_SERVER_URL=https://identity.example.com
KEYCLOAK_REALM=example-app
KEYCLOAK_CLIENT_ID=example-app-frontend
# Issuer must equal <server URL>/realms/<realm>.
KEYCLOAK_ISSUER_URL=https://identity.example.com/realms/example-app
# Without KEYCLOAK_INTERNAL_URL, JWKS derives from the same public base/realm.
KEYCLOAK_JWKS_URL=https://identity.example.com/realms/example-app/protocol/openid-connect/certs
KEYCLOAK_ENFORCE_AUDIENCE=true
# Audience may equal the backend client or use a separate API resource ID, but
# it must differ from the public frontend client.
KEYCLOAK_AUDIENCE=example-app-api
KEYCLOAK_ADMIN_CLIENT_ID=example-app-backend
KEYCLOAK_ADMIN_CLIENT_SECRET_FILE=/run/secrets/example_app_keycloak_backend_secret

DEBUG=false
DEBUG_ENABLED=false
SQL_ECHO_ENABLED=false
ENABLE_HTTP_DEBUG_LOGGING=false
LOG_LEVEL=INFO
LOG_REQUEST_HEADERS=false
LOG_REQUEST_BODY=false
LOG_RESPONSE_HEADERS=false
LOG_RESPONSE_BODY=false
AI_CHAT_DEBUG_ENABLED=false
AI_CHAT_DEBUG_INCLUDE_PROMPTS=false

# Optional AI capability. When enabled, its credential must remain file-backed.
# AI_CHAT_COMPLETIONS_ENDPOINT=https://provider.example/v1/chat/completions
# AI_CHAT_API_KEY_FILE=/run/secrets/example_app_ai_chat_api_key
# AI_CHAT_MODEL=provider-model-name

# Optional durable Web Push capability. Enabling dispatch requires both files.
# WEB_PUSH_VAPID_PUBLIC_KEY_FILE=/run/secrets/example_app_web_push_public_key
# WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/example_app_web_push_private_key
# WEB_PUSH_VAPID_SUBJECT=mailto:operations@example.com
# WEB_PUSH_DISPATCH_ENABLED=true
