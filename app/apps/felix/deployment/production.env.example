# Felix candidate production runtime (non-secret values only).
# Docker Swarm owns the files below and mounts them under /run/secrets.
APP_ENVIRONMENT=production
BACKEND_APP_ID=felix
APP_PROFILE=felix

DB_TYPE=postgresql
DB_MODE=external
DB_HOST=postgres
DB_PORT=5432
DB_NAME=felix
DB_USER=felix
DB_PASSWORD_FILE=/run/secrets/felix_db_password

CORS_ORIGINS=https://felix-app.fe-wi.com

AUTH_PROVIDER=keycloak
KEYCLOAK_SERVER_URL=https://keycloak.fe-wi.com
KEYCLOAK_REALM=felix
KEYCLOAK_CLIENT_ID=felix-new-frontend
KEYCLOAK_ISSUER_URL=https://keycloak.fe-wi.com/realms/felix
KEYCLOAK_JWKS_URL=https://keycloak.fe-wi.com/realms/felix/protocol/openid-connect/certs
KEYCLOAK_ENFORCE_AUDIENCE=true
KEYCLOAK_AUDIENCE=felix-new-backend
KEYCLOAK_ADMIN_CLIENT_ID=felix-new-backend
KEYCLOAK_ADMIN_CLIENT_SECRET_FILE=/run/secrets/felix_keycloak_admin_client_secret

DEBUG=false
DEBUG_ENABLED=false
SQL_ECHO_ENABLED=false
ENABLE_HTTP_DEBUG_LOGGING=false
LOG_LEVEL=INFO
LOG_REQUEST_HEADERS=false
LOG_REQUEST_BODY=false
LOG_RESPONSE_HEADERS=false
LOG_RESPONSE_BODY=false
AI_CHAT_DEBUG_ENABLED=false
AI_CHAT_DEBUG_INCLUDE_PROMPTS=false

# Optional AI capability. When enabled, its credential must remain file-backed.
# AI_CHAT_COMPLETIONS_ENDPOINT=https://provider.example/v1/chat/completions
# AI_CHAT_API_KEY_FILE=/run/secrets/felix_ai_chat_api_key
# AI_CHAT_MODEL=provider-model-name

# Optional durable Web Push capability. Enabling dispatch requires both files.
# WEB_PUSH_VAPID_PUBLIC_KEY_FILE=/run/secrets/felix_web_push_public_key
# WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/felix_web_push_private_key
# WEB_PUSH_VAPID_SUBJECT=mailto:operations@fe-wi.com
# WEB_PUSH_DISPATCH_ENABLED=true
